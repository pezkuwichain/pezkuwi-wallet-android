<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/kurdDetailsIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:padding="10dp"
            tools:src="@drawable/shield_checkmark_outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kurdDetailsName"
                style="@style/TextAppearance.NovaFoundation.Bold.Title3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                tools:text="serok.gov.kurd" />

            <TextView
                android:id="@+id/kurdDetailsKind"
                style="@style/TextAppearance.NovaFoundation.Regular.Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="@string/dapp_kurd_kind_official" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/kurdDetailsExplanation"
        style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.2"
        tools:text="@string/dapp_kurd_registered_explanation" />

    <io.novafoundation.nova.common.view.TableView
        android:id="@+id/kurdDetailsTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <io.novafoundation.nova.common.view.TableCellView
            android:id="@+id/kurdDetailsVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:title="@string/dapp_kurd_details_verification" />

        <io.novafoundation.nova.common.view.TableCellView
            android:id="@+id/kurdDetailsOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:title="@string/dapp_kurd_details_owner" />

        <io.novafoundation.nova.common.view.TableCellView
            android:id="@+id/kurdDetailsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:title="@string/dapp_kurd_details_content" />
    </io.novafoundation.nova.common.view.TableView>

    <io.novafoundation.nova.common.view.PrimaryButton
        android:id="@+id/kurdDetailsClearData"
        style="@style/Widget.Nova.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dapp_kurd_clear_site_data" />
</LinearLayout>
