<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dappRecyclerViewCatalog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/drawable_background_image"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layoutManager="io.novafoundation.nova.common.view.recyclerview.LinearLayoutManagerFixed" />

    <!-- The Dijital Kurdistan Ecosystem Hub, over the catalog while it is open. -->
    <io.novafoundation.nova.feature_dapp_impl.presentation.main.hub.DksHubView
        android:id="@+id/dappDksHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
