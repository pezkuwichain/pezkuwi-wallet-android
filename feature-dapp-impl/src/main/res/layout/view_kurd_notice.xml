<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kurdNotice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_screen_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/kurdNoticeName"
        style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="serok.gov.kurd" />

    <ImageView
        android:id="@+id/kurdNoticeIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no"
        android:padding="16dp"
        tools:src="@drawable/ic_warning_filled" />

    <TextView
        android:id="@+id/kurdNoticeTitle"
        style="@style/TextAppearance.NovaFoundation.Bold.Title3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        tools:text="@string/dapp_kurd_refused_title" />

    <TextView
        android:id="@+id/kurdNoticeMessage"
        style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        tools:text="@string/dapp_kurd_refused_message" />

    <!-- Who stopped the name, until when, and the hash of their written reasons (D23) -->
    <LinearLayout
        android:id="@+id/kurdNoticeSuspension"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_block_12"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dapp_kurd_suspended_by" />

            <TextView
                android:id="@+id/kurdNoticeSuspensionBy"
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dapp_kurd_suspended_until" />

            <TextView
                android:id="@+id/kurdNoticeSuspensionUntil"
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dapp_kurd_suspended_reason" />

            <TextView
                android:id="@+id/kurdNoticeSuspensionReason"
                style="@style/TextAppearance.NovaFoundation.Regular.Caption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <io.novafoundation.nova.common.view.PrimaryButton
        android:id="@+id/kurdNoticePrimary"
        style="@style/Widget.Nova.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        tools:text="@string/common_retry" />

    <TextView
        android:id="@+id/kurdNoticeSecondary"
        style="@style/TextAppearance.NovaFoundation.Regular.Footnote.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="44dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        tools:text="@string/dapp_kurd_open_anyway"
        tools:visibility="visible" />
</LinearLayout>
